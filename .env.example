# PawConnect settings. Copy this file to .env and fill in what you need:
#     cp .env.example .env
# Everything is optional – with an empty .env PawConnect uses SQLite, the sandbox
# payment gateway and simulated e-mails (data/outbox.log), so no external service is needed.
# NEVER commit your real .env (it is listed in .gitignore).

# ---------------------------------------------------------------- database
# Leave empty for the built-in SQLite file data/pawconnect.db.
# PostgreSQL (start it with:  docker compose up -d):
# DATABASE_URL=postgresql+psycopg://pawconnect:pawconnect@localhost:5432/pawconnect
DATABASE_URL=
# Print every SQL statement (1 = yes)
PAWCONNECT_DB_ECHO=0

# ---------------------------------------------------------------- REST API
PAWCONNECT_API_HOST=127.0.0.1
PAWCONNECT_API_PORT=5000
# Where the web app / desktop console find the API (python main.py --all sets this for you)
PAWCONNECT_API_URL=http://127.0.0.1:5000
# api = always use the HTTP API · local = run it in-process (offline demo) · auto = API if running, else local
PAWCONNECT_MODE=auto
PAWCONNECT_API_TIMEOUT=15
# Secret used to sign sign-in tokens (JWT). Make one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
# If empty, a new random secret is made every time the API starts (everyone is signed out on restart).
PAWCONNECT_JWT_SECRET=
# The only browser origin allowed by CORS (the Streamlit web app)
PAWCONNECT_WEB_ORIGIN=http://localhost:8501

# ---------------------------------------------------------------- payments
# Secret of the built-in sandbox gateway (signs its fake webhooks)
PAWCONNECT_PAYMENT_SECRET=pawconnect-sandbox-secret
# Real Razorpay TEST mode – https://dashboard.razorpay.com → switch to Test mode → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Settings → Webhooks → add  <public URL>/payments/webhook  and choose a secret
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- e-mail (every notification: OTP, receipts, updates)
# Leave SMTP_USER / SMTP_PASSWORD empty to simulate e-mails (data/outbox.log + OTP shown on screen).
# For Gmail: SMTP_PASSWORD must be a Gmail APP PASSWORD (16 letters), NOT your normal Gmail password.
#   Google Account → Security → turn on 2-Step Verification → search "App passwords" → create one.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# What recipients see as the sender. Default: PawConnect <SMTP_USER>
SMTP_FROM=
# Show the OTP on screen while e-mail is simulated (ignored – always hidden – once SMTP is set)
PAWCONNECT_SHOW_OTP=1
